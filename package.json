{
  "name": "animation-vs-animator",
  "version": "0.1.0",
  "description": "A procedural stick-figure desktop pet that lives on your screen.",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "start": "node scripts/build.mjs && electron .",
    "start:release": "node scripts/build.mjs release && electron .",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs release",
    "lab": "node scripts/build.mjs lab && node scripts/preview.mjs dist/lab/index.html",
    "modellab": "node scripts/build.mjs modellab && node scripts/preview.mjs dist/lab/prop-model.html",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"scripts/**/*.{ts,mjs,cjs}\" \"extension/**/*.{js,css}\"",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "sim": "node scripts/check.mjs sim",
    "soak": "node scripts/check.mjs soak",
    "package": "node scripts/package-release.mjs",
    "native:mac": "node scripts/build-native-mac.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.1",
    "esbuild": "^0.28.2",
    "prettier": "3.10.1",
    "typescript": "^6.0.2"
  }
}
